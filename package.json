{
  "name": "hendy-video-studio-vietsub-new-pro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:gateway": "npm --workspace=services/api-gateway run dev",
    "dev:ai-worker": "npm --workspace=services/ai-worker run dev",
    "dev:studio": "npm --workspace=apps/studio-web run dev",
    "build": "npm-run-all --parallel build:*",
    "build:packages": "npm --workspaces --if-present run build",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.3"
  }
}
